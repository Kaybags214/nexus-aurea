{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusaurea.example/schemas/review-envelope-1.0.0.json",
  "title": "Nexus Aurea Review Envelope",
  "description": "The single structured output every Nexus Aurea review workflow emits, and the only thing the Human Approval & Exception Gate accepts. Version 1.0.0 - DRAFT, not yet applied to any live workflow. See ops-hardening/03-review-envelope-contract.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_name",
    "submission_id",
    "review_type",
    "system_status",
    "confidence",
    "discrepancies",
    "missing_information",
    "evidence",
    "recommended_human_action"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "workflow_name": {
      "type": "string",
      "minLength": 1,
      "description": "Which workflow produced this envelope."
    },
    "submission_id": {
      "type": "string",
      "minLength": 1,
      "description": "Assigned at intake, before any processing. UUID recommended."
    },
    "review_type": {
      "enum": [
        "dg_document_review",
        "physical_shipment_capture",
        "building_maintenance_alert"
      ]
    },
    "system_status": {
      "enum": [
        "REJECT_INTAKE",
        "HOLD",
        "HUMAN_REVIEW_REQUIRED",
        "REVIEW_COMPLETE_NO_DISCREPANCIES_FOUND"
      ],
      "description": "Computed by the decision-policy node from countable facts. NEVER generated by the model, and never a word implying clearance - there is deliberately no PASS."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "System confidence in the review as a whole."
    },
    "confidence_basis": {
      "type": "string",
      "description": "How the confidence figure was arrived at."
    },
    "environment": {
      "enum": [
        "production",
        "sandbox"
      ],
      "description": "Asserted before any write. See 02-hardening-report.md F-P1."
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        }
      }
    },
    "documents": {
      "type": "array",
      "description": "Document identity. Fixes finding C-4. Carries no document CONTENT - filename is included because it is operationally necessary to reconcile a submission; if a filename itself carries client identity, hash it too.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_key",
          "sha256"
        ],
        "properties": {
          "field_key": {
            "type": "string",
            "description": "Multipart field the file arrived on."
          },
          "filename": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "mime": {
            "type": "string"
          },
          "pages": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "declared_scope": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the submission was routed AS - the queue it entered.",
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "type": "string"
        }
      }
    },
    "observed_scope": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the model actually read off the document. Compared against declared_scope by the class-scope gate (F-5). This pair is the fix for finding C-2.",
      "required": [
        "classes",
        "un_numbers"
      ],
      "properties": {
        "classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "un_numbers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unreadable": {
          "type": "boolean",
          "description": "True when scope could not be established. Forces HUMAN_REVIEW_REQUIRED - never 'none found, therefore fine'."
        }
      }
    },
    "discrepancies": {
      "type": "array",
      "description": "What was found. Send [] when none; never omit.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "field",
          "observed",
          "expected",
          "standard",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected": {
            "type": [
              "string",
              "null"
            ]
          },
          "standard": {
            "type": "string",
            "minLength": 1,
            "description": "Mandatory. A flag without a named standard is not a finding (AUDIT-ENGINE-PROMPT.md)."
          },
          "precedence_level": {
            "type": "string",
            "description": "Which level of standards-of-precedence.md the flag came from."
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "missing_information": {
      "type": "array",
      "description": "What could not be established. Send [] when none; never omit.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "item",
          "why_it_matters",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "item": {
            "type": "string",
            "minLength": 1
          },
          "why_it_matters": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean",
            "description": "true forces HOLD."
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "Where each finding came from. Send [] when none; never omit.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "discrepancy_id",
          "locator",
          "legibility"
        ],
        "properties": {
          "discrepancy_id": {
            "type": "string",
            "minLength": 1
          },
          "document_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "description": "A POSITION, not content: 'page 1, quantity column, line 1'. Survives redaction; safe for the public record."
          },
          "quote": {
            "type": "string",
            "description": "The ONLY field here that may contain document text. NEVER included in the public git record."
          },
          "legibility": {
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "description": "'low' forces HUMAN_REVIEW_REQUIRED."
          }
        }
      }
    },
    "recommended_human_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "steps"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_qualification": {
          "type": "string"
        },
        "do_not": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Safety instructions rendered to the reviewer every time, e.g. 'do not convert L to kg'."
        }
      }
    },
    "automation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "description": "All-false constants. Redundant with the gate's own assertion, deliberately - the property is stated at both ends of the pipe.",
      "properties": {
        "certifies": {
          "const": false
        },
        "clears": {
          "const": false
        },
        "signs": {
          "const": false
        },
        "tenders": {
          "const": false
        },
        "sends_to_client": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_type": {
            "const": "dg_document_review"
          }
        },
        "required": [
          "review_type"
        ]
      },
      "then": {
        "required": [
          "declared_scope",
          "observed_scope"
        ],
        "description": "A DG document review without a declared/observed scope pair cannot be class-scope gated."
      }
    }
  ]
}
